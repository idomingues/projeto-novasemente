APP_NAME="Nova Semente"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Versão no badge e em «Mais → Versão → Web» quando app_versions está vazio (alias: APP_VERSION).
# Se omitir, o Laravel tenta ler versionName em android/app/build.gradle no servidor de deploy.
# APP_DISPLAY_VERSION=2.1
# APP_VERSION=2.1
# No build front (npm run build), pode alinhar o bundle: VITE_APP_DISPLAY_VERSION=2.1

# Fuso para datas/horários de eventos e demais Carbon (ex.: America/Sao_Paulo)
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Com sqlite, o ficheiro em DB_DATABASE (por defeito database/database.sqlite) tem de existir; depois: php artisan migrate
# Diagnóstico: php artisan app:check-data
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Idle em minutos antes da sessão expirar (43200 = 30 dias). Usuário só sai com logout explícito + remember.
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produção (HTTPS atrás de proxy): obrigatório para o cookie de sessão ser enviado de forma estável.
# Local (http://localhost): deixe omitido ou false.
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Estatísticas de rotas mais vistas (agregação diária; gravação após a resposta). Desligar: PAGE_VIEWS_ENABLED=false
PAGE_VIEWS_ENABLED=true
# Utilizador autenticado: uma marcação por dia por rota (entrou na funcionalidade). Desligar: PAGE_VIEWS_TRACK_USER_DAILY_REACH=false
# PAGE_VIEWS_TRACK_USER_DAILY_REACH=true
# PAGE_VIEWS_DASHBOARD_DAYS=14
# PAGE_VIEWS_DASHBOARD_TOP=12

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: log grava em storage/logs/laravel.log (não chega à caixa de entrada).
# Produção (Brevo): ver scripts/brevo-setup.md — nunca MAIL_MAILER=log com APP_ENV=production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Marca nos e-mails (opcional; padrão = Nova Semente e /logo-ns.png)
# APP_NAME="Nova Semente"
# BRAND_NAME="Nova Semente"
# BRAND_TAGLINE=
# BRAND_LOGO_URL=
# BRAND_APP_URL="${APP_URL}"

# --- Produção (Brevo SMTP) — copiar para o .env do servidor, não commitar senhas ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=seu-login@email.com
# MAIL_PASSWORD=xsmtpsib-...
# MAIL_FROM_ADDRESS="noreply@novasemente.com.br"
# MAIL_FROM_NAME="Nova Semente"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# YouTube Data API v3 (Acervo mobile + importar playlist em Música).
# Cada pedido consome quota; se importar playlist falhar, verifique quotas no Google Cloud Console.
YOUTUBE_API_KEY=

# Google Drive API v3 (somente leitura) — opcional: capa automática em álbuns públicos.
GOOGLE_DRIVE_API_KEY=
IOS_APP_STORE_URL=https://apps.apple.com/br/app/nova-semente/id734369457
ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=br.org.novasemente.app
NATIVE_IOS_MINIMUM_VERSION=15.0

# Firebase Cloud Messaging (HTTP v1) — push nativo (Capacitor)
# Obtenha no Firebase Console → Project settings → Service accounts → Generate new private key
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Cole a chave privada como uma linha, trocando quebras de linha por \n
FCM_PRIVATE_KEY=

# Leitura de comprovantes (campanhas de doação): local = Tesseract no servidor; vision = reservado
RECEIPT_OCR_DRIVER=local
# TESSERACT_PATH=tesseract
# TESSERACT_LANG=por

VITE_APP_NAME="${APP_NAME}"
